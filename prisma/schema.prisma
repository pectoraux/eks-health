// Eks-Health Prisma schema — SQLite.
// Real persistence layer for accounts, sessions, waitlist, and health
// measurements. This is the first DB-backed slice of the platform; the rest
// of the modules still run on in-memory managers and will be migrated later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity: accounts + sessions
// ---------------------------------------------------------------------------

model EksAccount {
  id            String   @id
  email         String   @unique
  displayName   String
  state         String   @default("active") // unverified | active | suspended | locked | deleted
  personas      String   @default("participant") // comma-separated
  activePersona String   @default("participant")
  passwordHash  String?
  passwordSalt  String?
  mfaEnabled    Boolean  @default(false)
  isDemo        Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  locale        String?
  timezone      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSignInAt  DateTime?

  @@index([email])
}

model EksSession {
  id                 String   @id
  accountId          String
  persona            String
  accessToken        String   @unique
  refreshToken       String   @unique
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  refreshExpiresAt   DateTime
  absoluteExpiresAt  DateTime
  lastActiveAt       DateTime @default(now())
  state              String   @default("active") // active | expired | revoked | reauth_required
  ipAddress          String?
  userAgent          String?
  riskScore          Int      @default(0)
  mfaVerified        Boolean  @default(false)

  @@index([accountId])
  @@index([accessToken])
}

model EksWaitlistEntry {
  id              String   @id @default(cuid())
  name            String
  email           String
  country         String
  interestedRoles String   @default("participant") // comma-separated
  reason          String   @default("")
  referral        String?
  status          String   @default("pending") // pending | approved | rejected
  accountId       String?
  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Health: measurements (the core health data type)
// ---------------------------------------------------------------------------

model EksMeasurement {
  id               String   @id
  profileId        String
  schemaId         String
  dataJson         String   // full Measurement object as JSON snapshot
  verificationState String  @default("unverified")
  collectedAt      DateTime
  createdAt        DateTime @default(now())

  @@index([profileId])
  @@index([schemaId])
  @@index([collectedAt])
}

// ---------------------------------------------------------------------------
// Missions: goals + habits (participant-facing engagement)
// ---------------------------------------------------------------------------

model EksGoal {
  id           String   @id
  participantId String
  dataJson     String   // full Goal object as JSON snapshot
  state        String   @default("active")
  createdAt    DateTime @default(now())

  @@index([participantId])
  @@index([state])
}

model EksHabit {
  id            String   @id
  participantId String
  dataJson      String   // full Habit object as JSON snapshot
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([active])
}

model EksCompetition {
  id         String   @id
  slug       String   @unique
  programId  String
  dataJson   String   // full Competition object as JSON snapshot
  state      String   @default("draft")
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([state])
}

model EksListing {
  id         String   @id
  slug       String   @unique
  programId  String
  developerId String?
  dataJson   String   // full MarketplaceListing object as JSON snapshot
  status     String   @default("draft")
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([status])
  @@index([developerId])
}

model EksDeveloper {
  id        String   @id
  email     String   @unique
  dataJson  String   // full DeveloperProfile object as JSON snapshot
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model EksTechSession {
  id            String   @id
  technicianId  String?
  participantId String?
  programId     String?
  dataJson      String   // full MeasurementSession object as JSON snapshot
  state         String   @default("scheduled")
  createdAt     DateTime @default(now())

  @@index([technicianId])
  @@index([participantId])
  @@index([state])
}
