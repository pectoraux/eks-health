// Eks-Health Prisma schema — PostgreSQL (Neon)
// Used both locally and on Vercel for consistent persistence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity: accounts + sessions
// ---------------------------------------------------------------------------

model EksAccount {
  id            String   @id
  email         String   @unique
  displayName   String
  state         String   @default("active")
  personas      String   @default("participant")
  activePersona String   @default("participant")
  passwordHash  String?
  passwordSalt  String?
  mfaEnabled    Boolean  @default(false)
  isDemo        Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  locale        String?
  timezone      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSignInAt  DateTime?

  @@index([email])
}

model EksSession {
  id                 String   @id
  accountId          String
  persona            String
  accessToken        String   @unique
  refreshToken       String   @unique
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  refreshExpiresAt   DateTime
  absoluteExpiresAt  DateTime
  lastActiveAt       DateTime @default(now())
  state              String   @default("active")
  ipAddress          String?
  userAgent          String?
  riskScore          Int      @default(0)
  mfaVerified        Boolean  @default(false)

  @@index([accountId])
  @@index([accessToken])
}

model EksWaitlistEntry {
  id              String   @id @default(cuid())
  name            String
  email           String
  country         String
  interestedRoles String   @default("participant")
  reason          String   @default("")
  referral        String?
  status          String   @default("pending")
  accountId       String?
  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Health: measurements
// ---------------------------------------------------------------------------

model EksMeasurement {
  id                String   @id
  profileId         String
  schemaId          String
  dataJson          String
  verificationState String   @default("unverified")
  collectedAt       DateTime
  createdAt         DateTime @default(now())

  @@index([profileId])
  @@index([schemaId])
  @@index([collectedAt])
}

// ---------------------------------------------------------------------------
// Missions: goals + habits
// ---------------------------------------------------------------------------

model EksGoal {
  id            String   @id
  participantId String
  dataJson      String
  state         String   @default("active")
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([state])
}

model EksHabit {
  id            String   @id
  participantId String
  dataJson      String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Competitions + Marketplace + Developers + Tech Sessions
// ---------------------------------------------------------------------------

model EksCompetition {
  id         String   @id
  slug       String   @unique
  programId  String
  dataJson   String
  state      String   @default("draft")
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([state])
}

model EksListing {
  id          String   @id
  slug        String   @unique
  programId   String
  developerId String?
  dataJson    String
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  @@index([programId])
  @@index([status])
  @@index([developerId])
}

model EksDeveloper {
  id        String   @id
  email     String   @unique
  dataJson  String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model EksTechSession {
  id            String   @id
  technicianId  String?
  participantId String?
  programId     String?
  dataJson      String
  state         String   @default("scheduled")
  createdAt     DateTime @default(now())

  @@index([technicianId])
  @@index([participantId])
  @@index([state])
}
